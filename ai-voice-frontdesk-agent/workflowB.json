    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const customerPhone = $json.customerPhone;\nconst callId = $json.callId;\n\n// Defensive Guard: If call was missed but no caller ID is present, flag skip\nif (!customerPhone || customerPhone === 'unknown') {\n  return {\n    json: {\n      shouldSendSms: false,\n      reason: \"No valid caller ID available to recover call.\"\n    }\n  };\n}\n\n// System message for missed call recovery\nconst smsText = \"Hi there! We saw we just missed your call at the front desk. Would you like to schedule an appointment or ask a question? Reply to this text and our AI assistant can help you right now!\";\n\nreturn {\n  json: {\n    shouldSendSms: true,\n    toPhone: customerPhone,\n    smsText: smsText,\n    callId: callId\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        1008
      ],
