    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n\n// Extract key elements from Vapi end-of-call report structure\n//const customerPhone = message.call?.customer?.number || 'unknown';\n// Ensure we are referencing the nested message body sent by Vapi\nconst message = $json.body?.message || {};\n\nconst callId = message.call?.id || 'unknown';\nconst customerPhone = \"1234567\";\nconst endedReason = message.call?.endedReason || 'unknown';\n\n// Artifacts contain the direct recording and transcription elements\nconst transcript = message.artifact?.transcript || '';\nconst recordingUrl = message.artifact?.recordingUrl || '';\n\n// Analysis contains the post-call LLM evaluations and summaries\nconst summary = message.analysis?.summary || 'No summary provided.';\n\n\n// Determine outcome categories\nlet outcome = 'inquiry';\nif (endedReason === 'customer-did-not-answer' || endedReason === 'voicemail') {\n  outcome = 'missed';\n} else if (summary.toLowerCase().includes('book') || summary.toLowerCase().includes('scheduled')) {\n  outcome = 'booked';\n}\n\nreturn {\n  json: {\n    callId,\n    customerPhone,\n    endedReason,\n    summary,\n    outcome,\n    recordingUrl,\n    transcript\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
