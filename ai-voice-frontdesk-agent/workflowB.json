      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || {};\nconst message = body.message || {};\n\n// Extract key elements from Vapi end-of-call report structure\nconst callId = message.call?.id || 'unknown';\nconst customerPhone = message.call?.customer?.number || null;\nconst endedReason = message.endedReason || 'unknown';\nconst transcript = message.transcript || '';\nconst summary = message.analysis?.summary || 'No summary provided.';\nconst recordingUrl = message.recordingUrl || '';\n\n// Determine outcome categories\nlet outcome = 'inquiry';\nif (endedReason === 'customer-did-not-answer' || endedReason === 'voicemail') {\n  outcome = 'missed';\n} else if (summary.toLowerCase().includes('book') || summary.toLowerCase().includes('scheduled')) {\n  outcome = 'booked';\n}\n\nreturn {\n  json: {\n    callId,\n    customerPhone,\n    endedReason,\n    summary,\n    outcome,\n    recordingUrl,\n    transcript\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
