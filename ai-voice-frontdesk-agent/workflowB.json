        "jsonBody": "={\n  \"properties\": {\n    \"phone\": \"{{ $('Build SMS Recovery Payload').first().json.toPhone }}\",\n    \"last_missed_call_log\": \"[MISSED CALL RECOVERY DISPATCHED]\\nCaller: {{ $('Parse Call Summary').first().json.customerPhone }}\\nAction: Automated SMS recovery message sent via Vapi.\",\n    \"last_appointment_service\": \"Missed Call - Recovery SMS Sent\",\n    \"last_appointment_date\": \"{{ new Date().toISOString().split('T')[0] }}\"\n  }\n}",
