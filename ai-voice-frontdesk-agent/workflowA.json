      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const args = $json.args;\nconst BUSINESS_UTC_OFFSET = '+05:00'; // Adjust per client's actual timezone — no DST in Pakistan, so this is safe to hardcode here. For US clients, this would need to be a real decision, since US timezones DO observe DST.\n\nconst startDateTime = `${args.date}T${args.time}:00${BUSINESS_UTC_OFFSET}`;\nconst startDate = new Date(startDateTime);\nconst endDate = new Date(startDate.getTime() + 60 * 60 * 1000); // 1hr default block\nconst callerIdNumber = $json.callMeta?.customer?.number;\nconst resolvedPhone = callerIdNumber || args.phoneNumber || null; // null, not 'unknown' — see why below\n\nreturn {\n  json: {\n    toolCallId: $json.toolCallId,\n    customerName: args.customerName,\n    service: args.service,\n    callerPhone: resolvedPhone,\n    startISO: startDate.toISOString(),\n    endISO: endDate.toISOString()\n  }\n};"
      },
