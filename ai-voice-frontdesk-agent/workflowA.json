    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n//error handling\nif (!body || !body.message || body.message.type !== 'tool-calls') {\n  return [{\n    json: {\n      isValid: false,\n      errorReason: 'Payload missing message.type=tool-calls',\n      toolCallId: null,\n      functionName: null,\n      args: {}\n    }\n  }];\n}\n\nconst toolCallList = body.message.toolCallList;\nif (!Array.isArray(toolCallList) || toolCallList.length === 0) {\n  return [{\n    json: {\n      isValid: false,\n      errorReason: 'toolCallList missing or empty',\n      toolCallId: null,\n      functionName: null,\n      args: {}\n    }\n  }];\n}\n\n// MVP: handle the first tool call. Vapi can send multiple in one request —\n// we'll extend this to loop over all of them once the single-call path is proven working.\nconst call = toolCallList[0];\n\nreturn [{\n  json: {\n    isValid: true,\n    toolCallId: call.id,\n    functionName: call.function?.name || null,\n    args: call.function?.arguments || {},\n    callMeta: body.message.call || {}\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -992,
        -208
      ],
      "id": "ff90443c-5d32-4f9d-920e-62dc7311fcf2",
