    {
      "parameters": {
        "jsCode": "// Business hours: 9am–5pm, 1-hour slots\nconst businessStart = 9;\nconst businessEnd = 17;\n\n//Gather Calendar Appointments\nconst events = $input.all()\n  .map(item => item.json)\n  .filter(ev => ev && (ev.start || ev.end)); // discard any empty/placeholder items\n\n// Build list of busy hour from existing calendar events\nconst busyHours = new Set();\nfor (const ev of events) {\n  const start = new Date(ev.start?.dateTime || ev.start?.date);\n  const end = new Date(ev.end?.dateTime || ev.end?.date);\n  for (let h = start.getHours(); h < end.getHours(); h++) {\n    busyHours.add(h);\n  }\n}\n\n//find the free hours\nconst availableSlots = [];\nfor (let h = businessStart; h < businessEnd; h++) {\n  if (!busyHours.has(h)) {\n    availableSlots.push(`${h % 12 === 0 ? 12 : h % 12}:00 ${h < 12 ? 'AM' : 'PM'}`);\n  }\n}\n\n//Remember the original date discussed b/w ai agent and user\nconst original = $('ParseDataFromRequest').first().json;\n\nreturn [{\n  json: {\n    toolCallId: original.toolCallId,\n    functionName: original.functionName,\n    resultText: availableSlots.length > 0\n      ? `We have the following times available on ${original.args.date}: ${availableSlots.join(', ')}.`\n      : `Unfortunately we have no openings on ${original.args.date}. Would another date work?`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1216,
        -608
      ],
      "id": "7871b5e8-6c00-475e-83d3-27098ed88aff",
      "name": "FindAvailableSlots"
    },
